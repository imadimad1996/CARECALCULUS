rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Newsletter & Lead Subscriptions
    match /subscribers/{subscriberId} {
      // Secure: strictly validate the incoming document to prevent abuse
      allow create: if request.resource.data.keys().hasOnly(['email', 'lang', 'source', 'timestamp'])
                    && request.resource.data.email is string
                    && request.resource.data.email.matches('^[^@]+@[^@]+\\.[a-zA-Z]{2,}$');
                    
      allow read, update, delete: if false; // Secure: clients cannot read or dump subscribers
    }

    // User profiles (authenticated user can read & write their own record)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Default public collection for any future medical reference data
    match /public_reference/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Explicitly deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
