# CareCalculus Hospital Email Harvester — Environment Variables
# Copy this file to .env and fill in your real values.

# ── SMTP (Gmail example) ──────────────────────────────────────────
# For Gmail: enable 2FA → generate an "App Password" at
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password_here

# ── Sender identity ───────────────────────────────────────────────
FROM_NAME=CareCalculus Team
FROM_EMAIL=your@gmail.com

# ── Send behavior ─────────────────────────────────────────────────
# Seconds to wait between each email (avoid spam filters)
SEND_DELAY_SEC=5

# Only email leads with this score or higher (0-100+)
# Score >= 20 means a strong decision-maker signal
MIN_SCORE=15
